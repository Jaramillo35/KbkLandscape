---
import { biz } from '../data/site.js';
const { t } = Astro.props;
const { c, u } = t;
---
<section class="reviews" id="reviews" data-reviews aria-roledescription="carousel" aria-label={c.reviews.h2}>
  <!-- botanical sprig -->
  <svg class="sprig" viewBox="0 0 220 420" fill="none" aria-hidden="true" data-draw-scroll>
    <path d="M112 410C104 300 108 190 120 20" pathLength="1" />
    <path d="M116 330c-34-6-62-28-74-62 36 0 64 22 74 62zM114 250c34-8 60-32 68-66-36 2-62 26-68 66zM112 178c-30-8-52-30-60-60 32 2 54 24 60 60zM116 112c26-8 44-28 50-54-28 4-46 24-50 54zM119 56c-16-8-26-22-28-40 18 6 28 20 28 40z" pathLength="1" />
    <path d="M116 330c-20-22-44-42-74-62M114 250c20-22 44-44 68-66M112 178c-18-20-38-40-60-60M116 112c16-18 32-36 50-54" pathLength="1" class="thin" />
  </svg>
  <div class="wrap reviews-in">
    <p class="eyebrow" data-rise>{c.reviews.eyebrow}</p>
    <h2 class="sr">{c.reviews.h2}</h2>
    <div class="quotes" data-rise>
      {t.reviews.map((r, i) => (
        <figure class={`quote${i === 0 ? ' is-active' : ''}`} data-quote aria-hidden={i === 0 ? 'false' : 'true'}>
          <blockquote><p>“{r.text}”</p></blockquote>
          <figcaption><b>{r.name}</b><span>{r.what}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="quotes-nav" data-rise>
      <div class="quotes-dots" role="group" aria-label={u.prevNext}>
        {t.reviews.map((r, i) => (
          <button type="button" data-dot={i} aria-label={`${i + 1} / ${t.reviews.length}: ${r.name}`} aria-pressed={i === 0 ? 'true' : 'false'}><i></i></button>
        ))}
      </div>
      <a class="lnk lnk-arrow" href={biz.google} rel="noopener" target="_blank">{c.reviews.src}</a>
    </div>
  </div>
</section>
