---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Philosophy from '../components/Philosophy.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Dusk from '../components/Dusk.astro';
import Process from '../components/Process.astro';
import Promise from '../components/Promise.astro';
import Reviews from '../components/Reviews.astro';
import Area from '../components/Area.astro';
import { getT } from '../data/site.js';
const t = getT(Astro.props.lang);
---
<Base t={t} path="/" title={t.title('index')} desc={t.desc('index')}>
  <Hero t={t} />
  <Philosophy t={t} />
  <Services t={t} />
  <Work t={t} />
  <Dusk t={t} />
  <Process t={t} />
  <Promise t={t} />
  <Reviews t={t} />
  <Area t={t} />
</Base>
