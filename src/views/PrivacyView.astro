---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getT } from '../data/site.js';
const t = getT(Astro.props.lang);
const p = t.c.privacy_page;
---
<Base t={t} path="/privacy.html" title={p.title} desc={p.desc} solid>
  <PageHero eyebrow={p.eyebrow} h1={p.h1} lede={p.updated} />
  <div class="legal wrap">
    {p.sections.map(([h, body]) => (
      <section><h2>{h}</h2><div set:html={body}></div></section>
    ))}
  </div>
</Base>
